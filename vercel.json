{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm -r --filter @grogoni/web... --if-present build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "redirects": [
    {
      "source": "/android/grogoni-0.1.0-5.apk",
      "destination": "https://github.com/LuckiestManAliveEver/grogoni/releases/download/android-0.1.0-5/grogoni-0.1.0-5.apk",
      "permanent": false
    },
    {
      "source": "/android/grogoni-0.1.0-4.apk",
      "destination": "https://github.com/LuckiestManAliveEver/grogoni/releases/download/android-0.1.0-4/grogoni-0.1.0-4.apk",
      "permanent": false
    },
    {
      "source": "/android/grogoni-0.1.0-3.apk",
      "destination": "https://github.com/LuckiestManAliveEver/grogoni/releases/download/android-0.1.0-3/grogoni-0.1.0-3.apk",
      "permanent": false
    },
    {
      "source": "/android/grogoni-0.1.0-2.apk",
      "destination": "https://github.com/LuckiestManAliveEver/grogoni/releases/download/android-0.1.0-2/grogoni-0.1.0-2.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gnmndzsughifhboqvsgd.supabase.co/functions/v1/api/:path*?forceFunctionRegion=us-east-1"
    },
    {
      "source": "/.well-known/oauth-authorization-server/api",
      "destination": "https://gnmndzsughifhboqvsgd.supabase.co/functions/v1/api/.well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "https://gnmndzsughifhboqvsgd.supabase.co/functions/v1/api/.well-known/oauth-protected-resource"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
