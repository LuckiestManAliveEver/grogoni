NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
VITE_API_BASE_URL=http://127.0.0.1:4000
VITE_API_URL=http://127.0.0.1:4000
APP_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:4000
# Public API used by the opt-in production runtime verification scripts. In the Vercel frontend +
# Supabase-backed API topology, this should be the public HTTPS URL of the Node API service.
GROGONI_API_URL=https://grogoni.com
VITE_DEPLOYMENT_ENV=development
VITE_GIT_COMMIT_SHA=local
VITE_USE_POLLING=false
# Client-first inference (WebLLM/Transformers.js/native GGUF bridge) was retired in favor of the
# hosted-first Pi + SmolLM2 360M default (docs/architecture/swappable-agent-model-runtime.md).
# These VITE_* flags remain wired for the historical browser-local code paths but do not provide a
# fallback chat model - see VERCEL_INFERENCE_URL below for the runtime that actually serves chat.
VITE_BROWSER_LOCAL_INFERENCE_ENABLED=false
VITE_INFERENCE_CLIENT_FIRST=false
VITE_INFERENCE_BROWSER_WEBGPU_ENABLED=true
VITE_INFERENCE_BROWSER_WASM_ENABLED=true
VITE_INFERENCE_NATIVE_BRIDGE_ENABLED=false
VITE_INFERENCE_OWNER_NODE_ENABLED=false
VITE_INFERENCE_MAX_FALLBACKS=3
DEBUG_UI=false
WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SESSION_COOKIE_SECURE=false
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
# This API process never runs a model itself - it resolves a runtime binding, mints a signed
# model-artifact URL, and proxies inference to Vercel (docs/architecture/inference-runtime.md).
# For local dev, run the Vercel inference service separately with
# `pnpm --filter @grogoni/ai-runtime dev` (see services/ai-runtime/.env.example for its own env) and
# point VERCEL_INFERENCE_URL at whatever port `vercel dev` prints (http is allowed outside
# production only).
VERCEL_INFERENCE_URL=http://127.0.0.1:3000
VERCEL_INFERENCE_TIMEOUT_MS=300000
INFERENCE_REQUIRED=false
# Shared bearer secret between the API and services/ai-runtime - must be identical on both sides
# and at least 32 characters. Never reuse this value outside local dev.
GROGONI_INFERENCE_SERVICE_TOKEN=a30b3c0bcd66528537039cf4b5aada5634c0db48bbf7dcd2
# S3-compatible object storage where GGUF model artifact bytes actually live. The API uses these
# credentials only to mint short-lived signed download URLs (services/api/src/inference/
# model-artifact-store.ts) - it never streams the bytes itself.
NEON_MODEL_STORAGE_ENDPOINT=
NEON_MODEL_STORAGE_REGION=us-east-1
NEON_MODEL_STORAGE_ACCESS_KEY_ID=
NEON_MODEL_STORAGE_SECRET_ACCESS_KEY=
MODEL_ARTIFACT_URL_TTL_SECONDS=900
INFERENCE_OWNER_NODE_ENABLED=false
INFERENCE_MAX_FALLBACKS=3
INFERENCE_JOB_TIMEOUT_MS=120000
# Resource isolation (docs/architecture/resource-isolation.md): bounds how many inference calls
# services/api makes to ai-runtime concurrently, and how many more may wait for a slot before
# being rejected with a retryable 503 instead of piling up unboundedly.
INFERENCE_MAX_CONCURRENCY=4
INFERENCE_QUEUE_MAX=8
# Consecutive inference failures before the circuit opens and further calls fail fast (no network
# call at all) until INFERENCE_CIRCUIT_BREAKER_RESET_TIMEOUT_MS elapses and one probe is allowed.
INFERENCE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
INFERENCE_CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
# Postgres pool used only for model-artifact resolution on the inference path (index.ts). Separate
# budget from DB_POOL_MAX/cp2_primary - see docs/architecture/resource-isolation-audit.md §1.
DB_ARTIFACT_POOL_MAX=2
# Required only when INFERENCE_OWNER_NODE_ENABLED=true. Use a random value of at least 32 chars.
INFERENCE_JOB_SIGNING_SECRET=
# Native app and owner-node runtimes keep their own local model configuration.
INFERENCE_BROWSER_WEBGPU_ENABLED=true
INFERENCE_BROWSER_WASM_ENABLED=true
INFERENCE_NATIVE_BRIDGE_ENABLED=false
# Multi-provider inference router (docs/architecture/multi-provider-inference-implementation.md).
# Every variable here is optional and none is required to boot. Keys below are Grogoni-managed
# (Grogoni-funded) credentials; tenants and users connect their own keys in Settings -> AI providers,
# stored encrypted in Postgres. Leave a key blank to offer that provider as BYOK-only. Models are
# registered in the catalog (PUT /v1/platform/model-catalog/:id with an `inference` block), never
# here.
OPENAI_API_KEY=
# ZeroClaw agent runtime (docs/adr/ADR-zeroclaw-default-agent-runtime.md): the default engine for
# the Shopkeeper agent. Optional - unset runs Shopkeeper on Grogoni's built-in engine.
# ZEROCLAW_GATEWAY_URL=http://127.0.0.1:42617
# ZEROCLAW_ALLOW_PRIVATE_NETWORK=true
# ZEROCLAW_WEBHOOK_SECRET=
# ZEROCLAW_GATEWAY_TOKEN=
# ZEROCLAW_AGENT_ALIAS=
# ZEROCLAW_TIMEOUT_MS=120000
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# A Z.ai coding-plan endpoint is a different billing product: set both to expose it as its own
# provider id ("zai-coding"). It is never used for general chat or as a fallback for zai-general.
ZAI_CODING_BASE_URL=
ZAI_CODING_API_KEY=
# Grogoni-hosted llama.cpp (llama-server) or any OpenAI-compatible server Grogoni operates. Any host.
GROGONI_LLAMA_BASE_URL=
GROGONI_LLAMA_API_KEY=
# Operator-only escape hatches for a llama-server on a private network next to the API.
GROGONI_LLAMA_ALLOW_PRIVATE_NETWORK=false
GROGONI_LLAMA_ALLOW_HTTP=false
# Used only when a binding does not name a model. Never defaults to a commercial provider.
INFERENCE_DEFAULT_PROVIDER=
INFERENCE_DEFAULT_MODEL=
INFERENCE_REQUEST_TIMEOUT_MS=60000
INFERENCE_MAX_OUTPUT_TOKENS=1024
# Cost controls. Blank = unlimited. Amounts are in INFERENCE_BUDGET_CURRENCY; per-tenant/user
# overrides and the explicit fallback policy live in the inference_policies table.
INFERENCE_BUDGET_CURRENCY=USD
INFERENCE_TENANT_DAILY_BUDGET=
INFERENCE_USER_DAILY_BUDGET=
# "provider=amount,provider=amount", e.g. openai=500,anthropic=300
INFERENCE_PROVIDER_MONTHLY_CEILINGS=
INFERENCE_MAX_REQUESTS_PER_MINUTE=
INFERENCE_MAX_TOKENS_PER_REQUEST=
DB_INFERENCE_POOL_MAX=2
# Rotation keys for stored BYOK provider credentials: "2:<secret>,3:<secret>" (each at least 32
# characters; version 1 is AUTH_TOKEN_ENCRYPTION_KEY). New keys are written with the highest version
# and older rows are re-encrypted at API boot; drop an old version once its boot log reports none left.
INFERENCE_CREDENTIAL_KEYS=
# Optional for authenticated GitHub model discovery. Public discovery works at lower rate limits.
GITHUB_TOKEN=
# Optional for authenticated Hugging Face Hub model discovery. Public discovery remains available.
# Distinct from services/ai-runtime/.env.example's HF_TOKEN, which is the required, billing-
# relevant inference token for that separate deployment - this one is discovery-only and never used
# for inference. See docs/architecture/huggingface-inference.md for the full env-var map across
# both services, including PLATFORM_DEFAULT_MODEL_ID (set in Render, not here) for making the
# registered Qwen3-4B model the platform default once Hugging Face inference is configured.
HF_TOKEN=
CP2_STORE=postgres
# Local development uses Docker Postgres. Production can use Supabase Postgres: set DATABASE_URL to
# the pooled connection string for application traffic and DIRECT_DATABASE_URL to the direct/session
# connection string for migrations.
DATABASE_URL=postgres://grogoni:grogoni_dev_password@127.0.0.1:5432/grogoni_market
DIRECT_DATABASE_URL=postgres://grogoni:grogoni_dev_password@127.0.0.1:5432/grogoni_market
# Postgres connection budget for the cp2_primary/cp2_realtime pools (services/api/src/db-pool-config.ts).
# Defaults are production-safe starting points; only override for local tuning.
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=15000
DB_STATEMENT_TIMEOUT_MS=15000
# Attempts per boot-time database step before a transient network/DB failure aborts startup;
# 1 disables retries (docs/runbooks/db-startup-dns-flake.md).
DB_STARTUP_MAX_ATTEMPTS=6
# How often the expensive Phase 1 relational/compatibility parity check (12 full-table scans)
# refreshes in the background. /health/ready never runs it inline - see
# docs/architecture/resource-isolation-audit.md §2.
DB_HEALTH_PARITY_CHECK_INTERVAL_MS=60000
REDIS_URL=redis://127.0.0.1:6379
# Generate once with: pnpm --filter @grogoni/api exec web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operations@grogoni.com
OCR_ENGINE_PRIMARY=paddleocr
OCR_ENGINE_FALLBACK=tesseract
OCR_FALLBACK_ENABLED=true
OCR_PROFILE=balanced
OCR_LANGUAGE_HINTS=en,sw
OCR_ENGINE_VERSION=paddleocr-2.8.1
OCR_MODEL_VERSION=balanced-cpu
OCR_TEMP_IMAGE_TTL_HOURS=24
OCR_FAILED_IMAGE_TTL_HOURS=24
OCR_DELETE_AFTER_CONFIRM=true
OCR_MAX_UPLOAD_MB=10
OCR_MAX_IMAGE_EDGE=3000
OCR_MAX_PDF_PAGES=5
OCR_JOB_TIMEOUT_SECONDS=120
OCR_MAX_RETRIES=2
OCR_CONCURRENCY=1
# Resource isolation (docs/architecture/resource-isolation.md): bounded wait-queue depth beyond
# OCR_CONCURRENCY, and bounded exponential backoff+jitter between retries (replaces the immediate,
# no-delay retry this used to do - see docs/architecture/resource-isolation-audit.md §6).
OCR_QUEUE_MAX=10
OCR_RETRY_INITIAL_DELAY_MS=200
OCR_RETRY_MAX_DELAY_MS=5000
# Consecutive OCR-worker failures before the circuit opens and further scans fail fast with
# ocr_worker_unavailable until OCR_CIRCUIT_BREAKER_RESET_TIMEOUT_MS elapses.
OCR_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
OCR_CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
OCR_WORKER_URL=http://127.0.0.1:8090
NETWORK_INVITE_WEBHOOK_URL=
NETWORK_INVITE_WEBHOOK_SECRET=
MALWARE_SCANNER_ENABLED=false
MALWARE_SCANNER_URL=
MALWARE_SCANNER_SECRET=
REQUIRE_OBJECT_STORAGE=false
OBJECT_STORAGE_URL=
OBJECT_STORAGE_SECRET=
# Optional server-runtime workspace base. Each business is confined to <root>/<business-id>.
GROGONI_WORKSPACE_ROOT=
WORKSPACE_DELIVERY_MAX_FILE_BYTES=10000000
ENABLE_NOTIFICATION_DELIVERY_RUNNER=true
# Releases a retired storefront id (grogoniId) once its post-rename cooldown elapses. Defaults: check
# hourly, 30-day cooldown - see docs/architecture/grogoni-id-slug-system.md.
ENABLE_GROGONI_ID_COOLDOWN_RUNNER=true
GROGONI_ID_COOLDOWN_RUNNER_INTERVAL_MS=3600000
GROGONI_ID_COOLDOWN_MS=2592000000
OCR_CONTACT_MATCH_AUTO_SELECT=0.95
OCR_CONTACT_MATCH_CONFIRMATION_REQUIRED=0.80
OCR_CONTACT_MATCH_REJECT_BELOW=0.50
# Required only by the account-purge worker. The JSON value is an array of
# signed HTTPS deletion endpoints, for example:
# [{"id":"identity-gateway","url":"https://processor.example/delete-account"}]
ACCOUNT_DELETION_PROCESSORS_JSON=
ACCOUNT_DELETION_WEBHOOK_SECRET=
AUTH_BASE_URL=http://127.0.0.1:4000
AUTH_SECRET=replace-with-auth-secret
AUTH_SESSION_SECRET=replace-with-session-secret
AUTH_ALLOWED_REDIRECT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
WEBAUTHN_RP_ID=localhost
WEBAUTHN_EXPECTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUTH_PASSKEYS_ENABLED=true
AUTH_PASSWORD_FALLBACK_ENABLED=true
SESSION_ACCESS_TTL_SECONDS=900
SESSION_INACTIVITY_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=180
SESSION_ROTATION_ENABLED=true
SESSION_REUSE_DETECTION_ENABLED=true
OTP_HMAC_SECRET=replace-with-otp-hmac-secret
PIN_HASH_SECRET=replace-with-pin-hash-secret
# Random secrets of at least 32 characters. Keep previous values during rolling deploys.
PASSWORD_HASH_SECRET=replace-with-password-hash-secret
AUTH_AUDIT_HMAC_SECRET=replace-with-auth-audit-hmac-secret
# OTP settings apply to email verification and recovery only.
OTP_RATE_LIMIT_WINDOW_SECONDS=300
OTP_RATE_LIMIT_MAX_REQUESTS=5
OTP_COOLDOWN_SECONDS=60
# Enable only the OAuth providers whose application credentials are configured.
OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_ENABLED=false
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_TIKTOK_ENABLED=false
OAUTH_TIKTOK_CLIENT_ID=
OAUTH_TIKTOK_CLIENT_SECRET=
OAUTH_APPLE_ENABLED=false
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=
OAUTH_GITHUB_ENABLED=false
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_MICROSOFT_ENABLED=false
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_LINKEDIN_ENABLED=false
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=
OAUTH_X_ENABLED=false
OAUTH_X_CLIENT_ID=
OAUTH_X_CLIENT_SECRET=
# Required in production before enabling OAuth. Use a random value of at least 32 characters.
AUTH_TOKEN_ENCRYPTION_KEY=
GROGONI_FEATURE_FLAGS=rule_parser_stub
# Transactional email (signup OTP and encrypted-message notifications)
RESEND_API_KEY=
GROGONI_EMAIL_FROM="Grogoni <messages@grogoni.com>"
WEB_PUBLIC_URL=https://grogoni.com
# Official Telegram Bot API gateway. Token and webhook secret must be set together.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# Connected customer-mailbox OAuth. Separate these from registered-email and login OAuth settings.
# Provider console redirect URIs must include:
# https://<api-origin>/v1/mailboxes/oauth/gmail/callback
# https://<api-origin>/v1/mailboxes/oauth/outlook/callback
MAILBOX_GOOGLE_CLIENT_ID=
MAILBOX_GOOGLE_CLIENT_SECRET=
MAILBOX_MICROSOFT_CLIENT_ID=
MAILBOX_MICROSOFT_CLIENT_SECRET=
# Controlled incremental sync (minimum interval: 60000 ms).
ENABLE_CONNECTED_MAILBOX_SYNC_RUNNER=true
CONNECTED_MAILBOX_SYNC_INTERVAL_MS=300000
RENDER_API_KEY=...
GROGONI_TEST_TOKEN=...
GROGONI_TEST_SHOP_ID=...

# Deliberate offline runtime enrollment. Existing installs can sync when these are false.
OFFLINE_RUNTIME_ENABLED=false
VITE_OFFLINE_RUNTIME_ENABLED=false
# Optional nearby-device messaging over Web Bluetooth (Settings, offline mode only). Browser
# GATT-central role only - see docs/offline/p2p-transport-research.md.
VITE_PEER_MESSAGING_ENABLED=false
# Isolated browser worker. Use the same high-entropy bearer value in the API and worker services.
COMPUTER_RUNTIME_URL=http://127.0.0.1:8790
COMPUTER_RUNTIME_SERVICE_TOKEN=
