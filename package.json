{
  "name": "grogoni",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./services/api/dist/index.js",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.19.0 <23.0.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.5",
      "find-my-way": "^9.7.0",
      "tar": "^7.5.21",
      "sharp": "^0.35.0"
    }
  },
  "scripts": {
    "eval:inventory:hosted": "INVENTORY_BENCHMARK_PROVIDER=openrouter node --env-file-if-exists=.env.openrouter --import tsx services/api/src/benchmarks/run-inventory-benchmark.ts --require-model-pass",
    "eval:inventory": "node --import tsx services/api/src/benchmarks/run-inventory-benchmark.ts",
    "daemon:dev": "pnpm --filter @grogoni/api daemon:dev",
    "daemon:start": "pnpm --filter @grogoni/api daemon:start",
    "eval:daemon-live": "pnpm --filter @grogoni/api eval:daemon-live",
    "edge:local": "node --import tsx scripts/edge-local.mjs",
    "eval:daemon-lanes:local": "EVAL_TARGET=local node --import tsx scripts/eval-daemon-lanes-live.ts",
    "eval:daemon-lanes:production": "EVAL_TARGET=production node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/eval-daemon-lanes-live.ts",
    "test:live-openrouter": "node --env-file-if-exists=.env.openrouter --import tsx scripts/test-openrouter-runtime.ts",
    "android:identity:gate": "node scripts/verify-android-release-identity.mjs --require-approved",
    "android:identity:verify": "node scripts/verify-android-release-identity.mjs",
    "android:legal:gate": "node scripts/verify-play-legal-readiness.mjs --require-approved",
    "android:legal:verify": "node scripts/verify-play-legal-readiness.mjs",
    "android:release:apk": "cd apps/android && ./gradlew :app:assembleRelease",
    "android:release:assetlinks": "node scripts/generate-android-assetlinks.mjs",
    "build": "pnpm -r --if-present build",
    "build:production": "pnpm check:esm-relative-imports && pnpm build:production:workspace && pnpm check:production-imports && pnpm check:retired-runtime-references && pnpm check:retired-device-model-references && pnpm check:render-inference-boundaries",
    "build:production:workspace": "pnpm -r --filter \"./packages/**\" --if-present build && pnpm --filter @grogoni/web build && pnpm --filter @grogoni/api build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:api-routes": "tsx scripts/check-api-route-coverage.ts",
    "check:esm-relative-imports": "node scripts/check-esm-relative-imports.mjs",
    "check:production-imports": "node scripts/check-production-imports.mjs",
    "check:retired-runtime-references": "node scripts/check-retired-runtime-references.mjs",
    "check:retired-device-model-references": "node scripts/check-retired-device-model-references.mjs",
    "check:render-inference-boundaries": "node scripts/check-render-inference-boundaries.mjs",
    "check:shellview-boundary": "node scripts/check-shellview-boundary.mjs",
    "check:web-bundle-budgets": "VITE_API_BASE_URL=${VITE_API_BASE_URL:-http://127.0.0.1:4000} pnpm --filter @grogoni/web build && node scripts/check-web-bundle-budgets.mjs",
    "ci": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm check:esm-relative-imports && pnpm android:identity:verify && pnpm android:legal:verify && pnpm check:boundaries && pnpm check:api-routes && pnpm check:shellview-boundary && pnpm check:web-bundle-budgets",
    "clean:dev": "pnpm --filter @grogoni/web clean:dev",
    "dev": "pnpm -r --parallel --stream --filter @grogoni/api --filter @grogoni/web run dev",
    "dev:local": "GROGONI_RUNTIME_MODE=local LOCAL_CACHE_MODE=memory pnpm dev",
    "dev:api": "pnpm --filter @grogoni/api dev",
    "dev:web": "pnpm --filter @grogoni/web dev",
    "dev:web:poll": "pnpm --filter @grogoni/web dev:poll",
    "dev:stack": "docker compose up -d postgres",
    "dev:stack:down": "docker compose down",
    "db:backup": "pnpm --filter @grogoni/api db:backup",
    "db:backup:verify": "pnpm --filter @grogoni/api db:backup:verify",
    "db:backfill-native-runtime": "pnpm --filter @grogoni/api db:backfill-native-runtime",
    "db:grant-platform-operator": "pnpm --filter @grogoni/api db:grant-platform-operator",
    "db:health": "pnpm --filter @grogoni/api db:health",
    "db:migrate": "pnpm --filter @grogoni/api db:migrate",
    "db:purge-shops": "pnpm --filter @grogoni/api db:purge-shops",
    "db:purge-accounts": "pnpm --filter @grogoni/api db:purge-accounts",
    "db:verify-schema": "pnpm --filter @grogoni/api db:verify-schema",
    "db:verify-neon-production": "REQUIRE_NEON_DATABASE=true pnpm --filter @grogoni/api db:verify-schema",
    "db:rollback": "pnpm --filter @grogoni/api db:rollback",
    "db:restore": "pnpm --filter @grogoni/api db:restore",
    "db:store-lock": "pnpm --filter @grogoni/api db:store-lock",
    "eval:ai": "pnpm --filter @grogoni/api eval:ai",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "health:api": "node scripts/health-check.mjs",
    "jobs:schedule:supabase": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/schedule-supabase-jobs.mjs",
    "health:connected": "node scripts/check-connected-deployment.mjs",
    "health:browser": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/smoke-production-browser.mjs",
    "health:api:supabase": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/deploy-supabase-api.mjs",
    "test:business:supabase": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/test-supabase-business.mjs --live",
    "deploy:api:supabase": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/deploy-supabase-api.mjs --deploy",
    "lint": "eslint . --max-warnings=0",
    "local:doctor": "node scripts/local-doctor.mjs",
    "restart:dev": "pnpm clean:dev && pnpm dev",
    "start": "pnpm --filter @grogoni/api start",
    "test": "vitest run",
    "test:postgres": "node scripts/run-postgres-tests.mjs",
    "test:mcp:openai": "node scripts/test-openai-grogoni-mcp.mjs",
    "test:live-model-runtime": "RUN_LIVE_MODEL_RUNTIME_TEST=true vitest run tests/live-render-model-runtime.test.ts",
    "test:ui-cert": "playwright test e2e/responsive-accessibility.spec.ts",
    "typecheck": "pnpm -r --filter \"./packages/**\" --if-present build && pnpm -r --if-present typecheck",
    "verify:production-runtime": "node --env-file-if-exists=.env scripts/verify-production-runtime.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.18.0",
    "@mlc-ai/web-llm": "0.2.85",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.2",
    "drizzle-orm": "^0.38.4",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.4.2",
    "standardwebhooks": "^1.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
