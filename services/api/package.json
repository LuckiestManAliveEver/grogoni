{
  "name": "@grogoni/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "db:backfill-native-runtime": "node scripts/backfill-native-runtime-bindings.mjs",
    "db:grant-platform-operator": "node scripts/grant-platform-operator.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "db:backup:verify": "node scripts/verify-backup-db.mjs",
    "db:health": "node scripts/check-db-health.mjs",
    "db:migrate": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local scripts/migrate-db.mjs",
    "db:purge-shops": "node scripts/purge-shop-deletions.mjs",
    "db:purge-accounts": "node scripts/purge-account-deletions.mjs",
    "db:verify-schema": "node scripts/verify-db-schema.mjs",
    "phone-identities:audit": "tsx scripts/audit-phone-identities.ts",
    "phone-identities:normalize": "tsx scripts/audit-phone-identities.ts",
    "eval:ai": "tsx scripts/run-ai-eval.ts",
    "vapid:generate": "node scripts/generate-vapid-env.mjs",
    "db:rollback": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local scripts/rollback-db.mjs",
    "db:restore": "node scripts/restore-db.mjs",
    "db:store-lock": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local scripts/store-lock.mjs",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node scripts/write-build-manifest.mjs",
    "clean": "rm -rf dist",
    "dev": "tsx watch --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env.openrouter src/index.ts",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.openrouter dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.3.0",
    "@grogoni/business-core": "workspace:*",
    "@grogoni/event-core": "workspace:*",
    "@grogoni/observability": "workspace:*",
    "@grogoni/offline-runtime": "workspace:*",
    "@grogoni/resource-control": "workspace:*",
    "@grogoni/shared-types": "workspace:*",
    "@grogoni/sync-core": "workspace:*",
    "@grogoni/tool-core": "workspace:*",
    "@simplewebauthn/server": "^13.0.0",
    "@thednp/dommatrix": "2.0.12",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "^1.13.9",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "standardwebhooks": "^1.1.1",
    "web-push": "^3.6.7",
    "xlsx": "file:../../vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1"
  }
}
