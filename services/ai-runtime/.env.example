# Vercel executes inference only - it never sees Neon's Postgres, business/chat state, or tool
# credentials. Run locally with `pnpm --filter @grogoni/ai-runtime dev` (Vercel CLI dev server); see
# docs/deployment/vercel-inference.md.

# Shared bearer secret with the Render API (services/api's GROGONI_INFERENCE_SERVICE_TOKEN) - must be
# identical on both sides and at least 32 characters.
GROGONI_INFERENCE_SERVICE_TOKEN=a30b3c0bcd66528537039cf4b5aada5634c0db48bbf7dcd2

# Default engine for any requested model id that Hugging Face routing below does not claim.
# `llama-cpp` (the default if unset) downloads and runs a GGUF artifact locally. `huggingface` is
# the legacy exclusive mode: every model routes to Hugging Face, using HF_MODEL_MAP or falling back
# to HF_MODEL_ID - kept only for deployments that relied on that exact all-or-nothing behavior.
#
# Recommended for new deployments: leave this at `llama-cpp` and configure HF_TOKEN/HF_MODEL_MAP
# below anyway. Any model id present in HF_MODEL_MAP is then routed to Hugging Face per request,
# concurrently with every other model still served by llama.cpp in the same deployment - no
# redeploy needed to move a model between the two, and no need to flip this to `huggingface` at all.
# See docs/architecture/huggingface-inference.md.
INFERENCE_PROVIDER=llama-cpp

# Required for either INFERENCE_PROVIDER=huggingface or the hybrid HF_MODEL_MAP mode above. This is
# the platform-operator's own Hugging Face inference token, billed to the platform's HF account for
# every request that does not carry a business's own authorized providerCredential (see
# ExternalConnectionsDomain.resolveInferenceToken on the API side). Never the same concern as the
# services/api-side HF_TOKEN, which is optional and used only for Hub discovery rate limits.
HF_TOKEN=
# JSON map from Grogoni catalog model IDs to Hugging Face Hub model IDs. Verify a candidate id is
# actually live on HF's shared Inference Providers API before adding it here - a Hub repository
# existing is not evidence it is servable (see the audit's live-verification table). Confirmed live
# as of this file's last update: Qwen/Qwen3-4B (via the featherless-ai backend).
HF_MODEL_MAP={"qwen3-4b":"Qwen/Qwen3-4B"}
# Optional fallback used only when INFERENCE_PROVIDER=huggingface (the legacy exclusive mode) and a
# requested id is not in HF_MODEL_MAP. Has no effect in the default hybrid mode above - an unmapped
# id there always falls through to llama-cpp, never to a silent HF default. Leave empty for strict
# allowlisting.
HF_MODEL_ID=
HF_INFERENCE_BASE_URL=https://router.huggingface.co/v1/

# Application-side safety net only (see docs/architecture/huggingface-inference.md's billing
# section) - once true, a single confirmed Hugging Face budget-exhaustion response (HTTP 402)
# permanently refuses further Hugging Face requests for the lifetime of this process instead of
# continuing to spend. Does not talk to Hugging Face's billing API and cannot enforce a dollar
# limit there; does not coordinate across concurrent serverless instances; resets on cold start.
# Configure a real spending limit in the Hugging Face billing dashboard as the authoritative control.
HF_FREE_TIER_ONLY=false

# Comma-separated hostnames this service is allowed to download model artifacts from (SSRF guard
# in src/artifact-loader.ts). Must include Neon's object-storage hostname, matching
# NEON_MODEL_STORAGE_ENDPOINT on the Render side. Required whenever any enabled model can reach the
# llama-cpp path - i.e. whenever INFERENCE_PROVIDER=llama-cpp (the default), even in hybrid mode
# with HF_MODEL_MAP also configured. Not required only in the legacy exclusive
# INFERENCE_PROVIDER=huggingface mode, where llama-cpp is never reachable at all.
MODEL_ARTIFACT_ALLOWED_HOSTS=

VERCEL_MAX_ARTIFACT_BYTES=450000000
INFERENCE_MAX_INPUT_CHARACTERS=64000
INFERENCE_MAX_OUTPUT_TOKENS=512
# Bounded LRU model cache size for one warm serverless instance (src/runtime-cache.ts). Keep small
# - each entry holds a fully loaded GGUF model in memory.
INFERENCE_RUNTIME_CACHE_ENTRIES=1
