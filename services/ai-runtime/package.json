{
  "name": "@grogoni/ai-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @grogoni/shared-types build && pnpm build:package",
    "build:package": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "vercel dev",
    "dev:server": "tsx src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@grogoni/shared-types": "workspace:*",
    "node-llama-cpp": "3.18.1"
  }
}
