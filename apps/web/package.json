{
  "name": "@grogoni/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean:dev": "rm -rf node_modules/.vite dist",
    "dev": "vite",
    "dev:poll": "VITE_USE_POLLING=true vite",
    "preview": "vite preview --host 127.0.0.1",
    "restart:dev": "pnpm clean:dev && pnpm dev",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@grogoni/offline-runtime": "workspace:*",
    "@grogoni/shared-types": "workspace:*",
    "@grogoni/sync-core": "workspace:*",
    "@grogoni/tool-core": "workspace:*",
    "@grogoni/ui": "workspace:*",
    "@mlc-ai/web-llm": "0.2.85",
    "@mlc-ai/web-xgrammar": "0.1.27",
    "@simplewebauthn/browser": "^13.0.0",
    "libphonenumber-js": "^1.13.9",
    "lucide-react": "^1.56.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@types/web-bluetooth": "^0.0.21",
    "tesseract.js-core": "7.0.0"
  }
}
